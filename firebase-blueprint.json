{
  "entities": {
    "Affiliate": {
      "title": "Affiliate",
      "description": "A service business or professional affiliated with CitaPro MX",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "businessName": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "description": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "phone": { "type": "string" },
        "logo": { "type": "string" },
        "banner": { "type": "string" },
        "gallery": { "type": "array" },
        "videoUrl": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "completedAppointments": { "type": "number" },
        "plan": { "type": "string", "enum": ["basico", "pro", "equipo", "comision"] },
        "isTurbo": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "services": { "type": "array" },
        "workingHours": { "type": "object" },
        "availableToday": { "type": "boolean" },
        "availableTomorrow": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "businessName", "category", "state", "city", "phone", "plan"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A service appointment booked by a client with an affiliate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "affiliateId": { "type": "string" },
        "affiliateName": { "type": "string" },
        "serviceName": { "type": "string" },
        "servicePrice": { "type": "number" },
        "serviceDuration": { "type": "number" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "refunded_partial", "refunded_full", "pending"] },
        "paymentMethod": { "type": "string" },
        "paidAmount": { "type": "number" },
        "refundAmount": { "type": "number" },
        "rescheduleCount": { "type": "number" },
        "notes": { "type": "string" },
        "internalNotes": { "type": "string" },
        "whatsappMessages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "affiliateId", "serviceName", "servicePrice", "clientName", "clientPhone", "date", "time", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified client review for an affiliate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "affiliateId": { "type": "string" },
        "appointmentId": { "type": "string" },
        "clientName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "affiliateId", "appointmentId", "clientName", "rating", "comment"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile for registered clients and affiliates",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "affiliate", "admin", "promoter"] },
        "affiliateId": { "type": "string" },
        "approvalStatus": { "type": "string", "enum": ["pending_approval", "approved", "rejected"] },
        "professionalDocument": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "PromoterProfile": {
      "title": "PromoterProfile",
      "description": "Affiliate promoter who shares referral code to earn 40% recurring monthly commission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "referralCode": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "commissionPercent": { "type": "number" },
        "totalEarningsMxn": { "type": "number" },
        "currentMonthEarningsMxn": { "type": "number" },
        "availableBalanceMxn": { "type": "number" },
        "totalPaidOutMxn": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "referralCode", "name", "email", "commissionPercent"]
    },
    "ReferredAffiliate": {
      "title": "ReferredAffiliate",
      "description": "Professional affiliate referred by promoter earning 40% monthly recurring commission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "promoterUserId": { "type": "string" },
        "promoterCode": { "type": "string" },
        "affiliateId": { "type": "string" },
        "affiliateName": { "type": "string" },
        "businessName": { "type": "string" },
        "plan": { "type": "string" },
        "monthlyPriceMxn": { "type": "number" },
        "monthlyCommissionMxn": { "type": "number" },
        "isSubscriptionActive": { "type": "boolean" },
        "subscriptionStatus": { "type": "string" },
        "totalCommissionsGeneratedMxn": { "type": "number" }
      },
      "required": ["id", "promoterUserId", "promoterCode", "affiliateId", "monthlyCommissionMxn"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles with authentication and approval credentials"
    },
    "/affiliates/{affiliateId}": {
      "schema": { "$ref": "#/entities/Affiliate" },
      "description": "Stores professional affiliates and business profiles"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Stores booked appointments and Twilio notification audit logs"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Stores client reviews for affiliates"
    },
    "/promoters/{promoterId}": {
      "schema": { "$ref": "#/entities/PromoterProfile" },
      "description": "Stores promoter partner accounts with referral codes and balances"
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferredAffiliate" },
      "description": "Stores affiliate referral attribution and recurring 40% commissions"
    }
  }
}
